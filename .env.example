# ============================================================
# RAG Platform — environment variables template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Application
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Database (postgresql+asyncpg:// scheme required)
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@postgres:5432/ragdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO_SQL=false

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (host:port without scheme)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_min_8_chars
MINIO_USE_TLS=false

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Keycloak OIDC
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=rag-platform
KEYCLOAK_CLIENT_ID=rag-api
KEYCLOAK_AUDIENCE=rag-api

# LLM / Embedding (Ollama or vLLM — OpenAI-compatible API)
# Override LLM_BASE_URL to point at your GPU host
LLM_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama

# Ingest
INGEST_NODE_MAX_RETRIES=3
INGEST_PRESIGNED_URL_TTL_SECONDS=300
MINIO_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# RAG
RETRIEVAL_TOP_K=8
RETRIEVAL_RELEVANCE_THRESHOLD=0.5

# Langfuse (optional — leave empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3030
